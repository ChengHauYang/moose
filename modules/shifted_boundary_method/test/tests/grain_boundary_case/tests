[Tests]
  design = 'modules/shifted_boundary_method/grain_boundary_case.md'
  issues = '#33666'
  [grain_boundary_sczm_coarse_lambda1]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_coarse_lambda1.i'
    csvdiff = 'grain_boundary_sczm_coarse_lambda1_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve a shifted cohesive zone problem with volumetric locking '
                  'correction on a polycrystalline grain structure whose grain IDs and interfaces '
                  'are determined from one complete boundary mesh.'
  []
  [complete_interface_mesh_file]
    requirement = 'The system shall solve a shifted cohesive zone problem on a polycrystalline '
                  'grain structure whose interfaces are determined from one complete boundary mesh '
                  'read from a file'
    [serial_mesh]
      type = 'CSVDiff'
      input = 'grain_boundary_sczm_mesh_file.i'
      csvdiff = 'grain_boundary_sczm_mesh_file_csv.csv'
      # The gold is a symlink to grain_boundary_sczm_coarse_lambda1_csv.csv
      mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
      recover = false
      detail = 'with the mesh generators run in the simulation, and'
    []
    [split]
      type = 'RunApp'
      input = 'grain_boundary_sczm_mesh_file.i'
      cli_args = '--split-mesh 2 --split-file grain_boundary_sczm_mesh_file_split'
      mesh_mode = REPLICATED
      recover = false
      prereq = 'complete_interface_mesh_file/serial_mesh'
      detail = 'with a mesh split ahead of time, for which the mesh generators do not run,'
    []
    [use_split]
      type = 'CSVDiff'
      input = 'grain_boundary_sczm_mesh_file.i'
      cli_args = '--use-split --split-file grain_boundary_sczm_mesh_file_split'
      csvdiff = 'grain_boundary_sczm_mesh_file_csv.csv'
      min_parallel = 2
      max_parallel = 2
      recover = false
      prereq = 'complete_interface_mesh_file/split'
      detail = 'giving the same solution.'
    []
  []
  [case_insensitive_pair_names]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_coarse_lambda1.i'
    cli_args = "Mesh/rename/type=RenameBoundaryGenerator Mesh/rename/input=right_top "
               "Mesh/rename/old_boundary='grain1_grain2 grain1_grain4 grain1_grain5 grain2_grain4 grain3_grain4 grain3_grain5 grain4_grain5' "
               "Mesh/rename/new_boundary='Grain1_Grain2 Grain1_Grain4 Grain1_Grain5 Grain2_Grain4 Grain3_Grain4 Grain3_Grain5 Grain4_Grain5' "
               "Mesh/final_generator=rename "
               "interfaces='Grain1_Grain2 Grain1_Grain4 Grain1_Grain5 Grain2_Grain4 Grain3_Grain4 Grain3_Grain5 Grain4_Grain5' "
               "Outputs/exodus=false Outputs/csv/file_base=case_insensitive_pair_names_csv"
    csvdiff = 'case_insensitive_pair_names_csv.csv'
    # The gold is a symlink to grain_boundary_sczm_coarse_lambda1_csv.csv
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall infer the subdomain pair of a shifted cohesive zone interface '
                  'from a boundary name of the form grainX_grainY or blockX_blockY in any letter '
                  'case, including the BlockX_BlockY names of BreakMeshByBlockGenerator.'
  []
  [reversed_interface_pairs]
    type = CSVDiff
    input = 'grain_boundary_sczm_coarse_lambda1.i'
    csvdiff = 'grain_boundary_sczm_coarse_lambda1_csv.csv'
    cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs="'
               '2 1; 4 1; 5 1; 4 2; 4 3; 5 3; 5 4"'
    prereq = grain_boundary_sczm_coarse_lambda1
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall orient true-interface normals consistently regardless of '
                  'interface-subdomain pair ordering.'
  []
  [outside_grains]
    type = Exodiff
    input = 'outside_grains.i'
    exodiff = 'outside_grains_out.e'
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall retain an element input subdomain when no grain occupancy is '
                  'selected.'
  []
  [sparse_grain_ids]
    type = Exodiff
    input = 'sparse_grain_ids.i'
    exodiff = 'sparse_grain_ids_out.e'
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall preserve grain names when boundary subdomain IDs are zero-based '
                  'and noncontiguous.'
  []
  [grain_boundary_sczm_separate_interfaces]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_separate_interfaces.i'
    csvdiff = 'grain_boundary_sczm_separate_interfaces_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve a shifted cohesive zone problem on a polycrystalline '
                  'grain structure using a separately loaded surface mesh for each grain '
                  'interface.'
  []
  [explicit_surface_mesh_names]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_separate_interfaces.i'
    csvdiff = 'grain_boundary_sczm_separate_interfaces_csv.csv'
    cli_args = "Mesh/grain1_grain2/save_with_name=surface_12 "
               "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/surface_meshes='surface_12 grain1_grain4 grain1_grain5 grain2_grain4 grain3_grain4 grain3_grain5 grain4_grain5'"
    prereq = grain_boundary_sczm_separate_interfaces
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall associate each surrogate boundary with a user-selected saved '
                  'surface mesh.'
  []
  [grain_boundary_sczm_separate_grains]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_separate_grains.i'
    csvdiff = 'grain_boundary_sczm_separate_grains_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve a shifted cohesive zone problem on a polycrystalline '
                  'grain structure assembled from one separately loaded watertight shell per grain, '
                  'matching the single complete boundary mesh.'
  []
  [grain_boundary_sczm_separate_grains_list]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_separate_grains_list.i'
    csvdiff = 'grain_boundary_sczm_separate_grains_list_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall assemble the complete boundary mesh from per-grain watertight '
                  'shells supplied directly to the interface manager, matching the combined '
                  'single-mesh result.'
  []
  [grain_boundary_sczm_separate_interfaces_aligned]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_separate_interfaces_aligned.i'
    csvdiff = 'grain_boundary_sczm_separate_interfaces_aligned_csv.csv'
    rel_err = 1e-10
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve a shifted cohesive zone problem using one surface mesh '
                  'per already-formed grain interface, matching the complete boundary mesh result '
                  'to floating-point precision.'
  []
  [grain_boundary_sczm_3d_one_file]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_3d_one_file.i'
    csvdiff = 'grain_boundary_sczm_3d_one_file_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve a three-dimensional shifted cohesive zone problem on a '
                  'tetrahedral multi-grain structure whose interfaces are determined from one '
                  'complete boundary mesh.'
  []
  [grain_boundary_sczm_3d_separate_grains]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_3d_separate_grains.i'
    csvdiff = 'grain_boundary_sczm_3d_separate_grains_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve the three-dimensional problem from one separately loaded '
                  'watertight shell per grain, matching the single complete boundary mesh.'
  []
  [grain_boundary_sczm_3d_separate_grains_list]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_3d_separate_grains_list.i'
    csvdiff = 'grain_boundary_sczm_3d_separate_grains_list_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall assemble the three-dimensional complete boundary mesh from '
                  'per-grain watertight shells supplied directly to the interface manager, matching '
                  'the combined single-mesh result.'
  []
  [grain_boundary_sczm_3d_separate_interfaces]
    type = 'CSVDiff'
    input = 'grain_boundary_sczm_3d_separate_interfaces.i'
    csvdiff = 'grain_boundary_sczm_3d_separate_interfaces_csv.csv'
    mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
    recover = false
    requirement = 'The system shall solve the three-dimensional problem using one surface mesh per '
                  'already-formed grain interface, matching the complete boundary mesh result.'
  []
  [kokkos_weighted_traction]
    requirement = 'The system shall solve Kokkos total-Lagrangian shifted cohesive zones on '
                  'polycrystalline grain boundaries loaded through softening of a stateful NEML2 '
                  'traction-separation law, with weighted traction stabilization, element-local '
                  'stress recovery, and F-bar,'
    design = 'modules/shifted_boundary_method/grain_boundary_case.md SBMInterfaceManager.md '
             'KokkosSCZMStabilizationData.md SubdomainGrainIDGenerator.md'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
    [complete_interface_mesh_file]
      type = 'Exodiff'
      input = 'grain_boundary_sczm_kokkos_weighted.i'
      exodiff = 'grain_boundary_sczm_kokkos_weighted_out.e'
      detail = 'with the interfaces read by the interface manager from one complete boundary mesh '
               'file, and'
    []
    [surface_mesh_per_interface]
      type = 'Exodiff'
      input = 'grain_boundary_sczm_kokkos_weighted_aligned.i'
      # The gold is a symlink to grain_boundary_sczm_kokkos_weighted_out.e
      exodiff = 'grain_boundary_sczm_kokkos_weighted_aligned_out.e'
      mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
      # Recovery does not rerun the mesh generators, so the saved surface meshes that
      # SBMSurfaceMeshBuilder retrieves do not exist
      recover = false
      detail = 'with one surface mesh per interface, giving the same solution.'
    []
  []
  [error_tests]
    requirement = 'The system shall throw an error '
    [invalid_leaf_max_size]
      type = RunException
      input = 'outside_grains.i'
      cli_args = 'Mesh/grains/leaf_max_size=0'
      expect_err = 'Range check failed for parameter Mesh/grains/leaf_max_size'
      mesh_mode = REPLICATED
      detail = 'if the maximum k-d tree leaf size is nonpositive.'
    []
    [surface_mesh_count_mismatch]
      type = RunException
      input = 'grain_boundary_sczm_separate_interfaces.i'
      cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/surface_meshes='grain1_grain2'"
      expect_err = 'The number of surface meshes must match the boundaries.'
      mesh_mode = REPLICATED
      detail = 'if a saved surface mesh is not provided for each shifted cohesive zone boundary.'
    []
    [duplicate_surface_mesh]
      type = RunException
      input = 'grain_boundary_sczm_separate_interfaces.i'
      cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/surface_meshes='grain1_grain2 grain1_grain4 grain1_grain5 grain2_grain4 grain3_grain4 grain3_grain5 grain1_grain2'"
      expect_err = 'Each saved surface mesh may only be used once.'
      mesh_mode = REPLICATED
      detail = 'if one saved surface mesh is reused for multiple shifted cohesive zone boundaries.'
    []
    [complete_interface_pair_count]
      type = RunException
      input = 'grain_boundary_sczm_coarse_lambda1.i'
      cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs='1 2'"
      expect_err = 'Provide exactly one subdomain pair per boundary.'
      mesh_mode = REPLICATED
      detail = 'if one explicit subdomain pair is not provided for each surrogate boundary.'
    []
    [complete_interface_pair_size]
      type = RunException
      input = 'grain_boundary_sczm_coarse_lambda1.i'
      cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs='1; 1 4; 1 5; 2 4; 3 4; 3 5; 4 5'"
      expect_err = 'Each interface entry must contain two distinct subdomain IDs.'
      mesh_mode = REPLICATED
      detail = 'if an explicit interface entry does not contain two subdomain IDs.'
    []
    [complete_interface_distinct_pair]
      type = RunException
      input = 'grain_boundary_sczm_coarse_lambda1.i'
      cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs='1 1; 1 4; 1 5; 2 4; 3 4; 3 5; 4 5'"
      expect_err = 'Each interface entry must contain two distinct subdomain IDs.'
      mesh_mode = REPLICATED
      detail = 'if the two subdomain IDs in an explicit interface entry are not distinct.'
    []
    [ambiguous_distance_source]
      type = RunException
      input = 'grain_boundary_sczm_coarse_lambda1.i'
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/sbm_distance_uo=unused'
      expect_err = "Specify only one of 'sbm_distance_uo', 'generate_sbm_distance', and 'complete_interface_mesh'."
      mesh_mode = REPLICATED
      detail = 'if explicit and automatically generated distance sources are both specified.'
    []
    [unknown_manager_pair]
      type = RunException
      input = 'grain_boundary_sczm_coarse_lambda1.i'
      cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs='1 99; 1 4; 1 5; 2 4; 3 4; 3 5; 4 5'"
      expect_err = 'maps to an interface not detected by the manager.'
      mesh_mode = REPLICATED
      detail = 'if an explicit subdomain pair is absent from the detected complete interface.'
    []
    [nonconformal_interface]
      type = RunException
      input = 'nonconformal_interface.i'
      cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/boundary='grain1_grain2' "
                 "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_pairs='1 2'"
      expect_err = 'maps to an interface not detected by the manager.'
      mesh_mode = REPLICATED
      detail = 'if partially overlapping interface faces are found in a nonconformal complete interface mesh.'
    []
    [both_complete_interface_forms]
      type = RunException
      input = 'grain_boundary_sczm_separate_grains_list.i'
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/complete_interface_mesh=grain1_shell'
      expect_err = "Specify only one of 'complete_interface_mesh', 'complete_interface_mesh_file', and 'complete_interface_meshes'."
      mesh_mode = REPLICATED
      detail = 'if both the single complete interface mesh and the per-grain mesh list are given.'
    []
    [interface_subdomain_id_count]
      type = RunException
      input = 'grain_boundary_sczm_separate_grains_list.i'
      cli_args = "Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/interface_subdomain_ids='1 2 3 4'"
      expect_err = "'interface_subdomain_ids' must have one entry per mesh in 'complete_interface_meshes'."
      mesh_mode = REPLICATED
      detail = 'if the number of subdomain IDs does not match the number of per-grain meshes.'
    []
  []
[]
