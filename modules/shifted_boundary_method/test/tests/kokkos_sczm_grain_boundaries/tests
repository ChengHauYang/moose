    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cuda
    mesh_mode = REPLICATED
    recover = false
    requirement = 'The system shall reproduce the two-dimensional polycrystalline host crystal-plasticity and grain-boundary shifted cohesive-zone solution when the bulk and interface NEML2 updates, Kokkos assembly, and PETSc AIJKOKKOS solve all run on the CUDA device.'
  []

