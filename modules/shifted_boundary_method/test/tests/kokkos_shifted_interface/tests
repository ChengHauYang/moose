[Tests]
  design = 'syntax/Physics/SolidMechanics/ShiftedCohesiveZone/index.md'
  issues = '#33666 #30655'
  [shifted_penalty_jacobian]
    type = PetscJacobianTester
    input = shifted_penalty.i
    ratio_tol = 1e-7
    difference_tol = 1e-7
    requirement = 'The Kokkos shifted-interface base shall cache static shifted geometry on the device and consistently linearize first-order shifted values across all four interface Jacobian blocks.'
    capabilities = kokkos
    compute_devices = 'cpu cuda xpu'
    allow_test_objects = true
  []
  [sczm_linear_jacobian]
    type = PetscJacobianTester
    input = sczm_linear.i
    ratio_tol = 1e-7
    difference_tol = 1e-7
    requirement = 'The ShiftedCohesiveZone Physics shall create Kokkos small-strain shifted cohesive-zone kernels and materials that consistently assemble diagonal and cross-component traction-jump Jacobian blocks including the directional correction Jacobian, using device material properties.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = 'cpu cuda xpu'
  []
  [sczm_stateful_serial]
    type = Exodiff
    input = sczm_stateful_kokkos.i
    exodiff = sczm_stateful_kokkos_out.e
    abs_zero = 1e-8
    rel_err = 1e-8
    recover = false
    requirement = 'The Kokkos shifted cohesive-zone formulation shall execute a stateful NEML2 radial-return loading and unloading trajectory in serial while advancing history only after converged timesteps.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
  []
  [sczm_stateful_distributed]
    type = Exodiff
    input = sczm_stateful_kokkos.i
    exodiff = sczm_stateful_kokkos_out.e
    abs_zero = 1e-8
    rel_err = 1e-8
    min_parallel = 2
    max_parallel = 2
    mesh_mode = distributed
    recover = false
    requirement = 'The Kokkos shifted cohesive-zone formulation shall preserve stateful NEML2 loading and unloading results when interface elements and their ghost-side neighbors are distributed across MPI ranks.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
  []
  [sczm_pk1_host_jacobian]
    type = PetscJacobianTester
    input = sczm_pk1_host.i
    ratio_tol = 1e-7
    difference_tol = 1e-5
    requirement = 'The host shifted cohesive-zone formulation shall consistently linearize its directional correction when stress is first Piola-Kirchhoff stress and the full nonsymmetric constitutive tangent is its derivative with respect to deformation gradient.'
    capabilities = 'libtorch & neml2'
  []
  [sczm_pk1_kokkos_jacobian]
    type = PetscJacobianTester
    input = sczm_pk1_kokkos.i
    ratio_tol = 1e-7
    difference_tol = 1e-5
    requirement = 'The Kokkos shifted cohesive-zone formulation shall transfer full nonsymmetric NEML2 stress and deformation-gradient tangent properties on both interface sides and use the d(PK1)/d(F) directional-correction contraction.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = 'cpu'
  []
  [sczm_pk2_kokkos_jacobian]
    type = PetscJacobianTester
    input = sczm_pk2_kokkos.i
    ratio_tol = 1e-7
    difference_tol = 1e-5
    requirement = 'The ShiftedCohesiveZone Physics shall convert distinct primary- and neighbor-side full PK2 stress and deformation-gradient tangent properties to PK1 properties and consistently assemble all displacement couplings of the three-dimensional Kokkos directional correction.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
    allow_test_objects = true
  []
  [sczm_pk2_action_modes]
    requirement = 'The ShiftedCohesiveZone Physics PK2 input contract shall create converters only when the active directional correction consumes them and shall diagnose an unsupported active host conversion.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
    recover = false
    [directional_correction_inactive]
      type = RunApp
      input = sczm_pk2_action_modes.i
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/sczm/directional_correction=false'
      detail = 'It shall run without conversion when directional correction is disabled,'
    []
    [shifted_terms_inactive]
      type = RunApp
      input = sczm_pk2_action_modes.i
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/sczm/no_shifted=true Problem/solve=false'
      detail = 'initialize without conversion when all shifted terms are disabled,'
    []
    [host_active]
      type = RunException
      input = sczm_pk2_action_modes.i
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/sczm/use_kokkos=false'
      expect_err = 'Automatic PK2-to-PK1 conversion for directional correction is not yet supported on the CPU path'
      detail = 'and reject active conversion on the host backend.'
    []
  []
  [sczm_angled_host]
    type = Exodiff
    input = sczm_angled_host.i
    exodiff = sczm_angled_host_out.e
    recover = false
    requirement = 'The host shifted cohesive-zone formulation shall compute the displacement solution on a two-dimensional angled interface including the directional correction.'
  []
  [sczm_angled_kokkos_matches_host]
    type = Exodiff
    input = sczm_angled_kokkos.i
    exodiff = sczm_angled_kokkos_out.e
    # Host and Kokkos evaluate identical double-precision discrete equations, so they must agree tightly.
    abs_zero = 1e-8
    rel_err = 1e-8
    requirement = 'The Kokkos shifted cohesive-zone formulation shall produce the same displacement solution as the host formulation on a two-dimensional angled interface including the directional correction.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = 'cpu cuda xpu'
    # Recovery is disabled for the Kokkos interface comparisons because it does not rebuild the
    # interface neighbor state. The disjoint neighbor information is not currently saved to Exodus
    # or to the checkpoint file, so a recovered mesh comes back without it and the Kokkos interface
    # face cache cannot resolve the neighbor element of an interface face. It has to be regenerated
    # rather than recovered, and the recovery path does not do that yet.
    recover = false
  []
  [sczm_angled_noshifted_host]
    type = Exodiff
    input = sczm_angled_noshifted_host.i
    exodiff = sczm_angled_noshifted_host_out.e
    recover = false
    requirement = 'The host shifted cohesive-zone formulation shall compute the displacement solution on a two-dimensional angled interface with the shifted terms disabled.'
  []
  [sczm_angled_noshifted_kokkos_matches_host]
    type = Exodiff
    input = sczm_angled_noshifted_kokkos.i
    exodiff = sczm_angled_noshifted_kokkos_out.e
    # Host and Kokkos evaluate identical double-precision discrete equations, so they must agree tightly.
    abs_zero = 1e-8
    rel_err = 1e-8
    requirement = 'The Kokkos shifted cohesive-zone formulation shall reproduce the host solution with the shifted terms disabled, dropping the area correction, the shifted test functions, the displacement-jump gradient contribution, and the directional correction.'
    capabilities = kokkos
    compute_devices = 'cpu cuda xpu'
    # See sczm_angled_kokkos_matches_host for why recovery is disabled.
    recover = false
  []
  [sczm_angled_noshifted_jacobian]
    type = PetscJacobianTester
    input = sczm_angled_noshifted_kokkos.i
    ratio_tol = 1e-7
    difference_tol = 1e-7
    # With the shifted terms disabled the base traction Jacobian uses the natural test functions and
    # no area correction, and the directional correction contributes nothing. Comparing against
    # finite differences of that residual fails if either the area correction or the shifted test
    # functions are still applied.
    requirement = 'The Kokkos shifted cohesive-zone formulation shall assemble Jacobian entries consistent with its residual for both interface sides when the shifted terms are disabled.'
    capabilities = kokkos
    compute_devices = 'cpu cuda xpu'
  []
  [sczm_angled_3d_host]
    type = Exodiff
    input = sczm_angled_3d_host.i
    exodiff = sczm_angled_3d_host_out.e
    recover = false
    requirement = 'The host shifted cohesive-zone formulation shall compute the displacement solution on a three-dimensional angled interface including the directional correction.'
  []
  [sczm_angled_3d_kokkos_matches_host]
    type = Exodiff
    input = sczm_angled_3d_kokkos.i
    exodiff = sczm_angled_3d_kokkos_out.e
    # Host and Kokkos evaluate identical double-precision discrete equations, so they must agree tightly.
    abs_zero = 1e-8
    rel_err = 1e-8
    requirement = 'The Kokkos shifted cohesive-zone formulation shall produce the same displacement solution as the host formulation on a three-dimensional angled interface including the directional correction.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = 'cpu cuda xpu'
    # See sczm_angled_kokkos_matches_host for why recovery is disabled.
    recover = false
  []
  [sczm_hetero_host]
    type = Exodiff
    input = sczm_hetero_host.i
    exodiff = sczm_hetero_host_out.e
    recover = false
    requirement = 'The host shifted cohesive-zone formulation shall compute the displacement solution on an angled interface whose primary and neighbor bulk responses have different elastic constants.'
  []
  [sczm_hetero_kokkos_matches_host]
    type = Exodiff
    input = sczm_hetero_kokkos.i
    exodiff = sczm_hetero_kokkos_out.e
    # Host and Kokkos evaluate identical double-precision discrete equations, so they must agree tightly.
    abs_zero = 1e-8
    rel_err = 1e-8
    requirement = 'The Kokkos shifted cohesive-zone formulation shall consume the primary bulk stress and Lame constants for the element block and the neighbor ones for the neighbor block, producing the same displacement solution as the host formulation on a heterogeneous angled interface.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = 'cpu cuda xpu'
    # See sczm_angled_kokkos_matches_host for why recovery is disabled.
    recover = false
  []
  [sczm_hetero_jacobian_blocks]
    type = PetscJacobianTester
    input = sczm_hetero_kokkos.i
    ratio_tol = 1e-7
    difference_tol = 1e-7
    # The directional correction residual depends on the primary stress in the element row and on the
    # neighbor stress in the neighbor row, and on no other side's displacements. Comparing the
    # assembled Jacobian against finite differences of that residual therefore fails if primary and
    # neighbor properties are swapped in either residual row or in either diagonal block, or if a
    # correction term is added to either cross block.
    requirement = 'The Kokkos SCZM directional correction shall assemble Jacobian entries that are the exact derivative of its residual for both interface sides with independently configured bulk properties supplied through NEML2, where the NEML2 batch index is keyed by the primary quadrature point and the neighbor-side property is written to the corresponding neighbor storage quadrature point, and shall contribute no correction to the cross blocks.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = 'cpu cuda xpu'
  []
  [sczm_angled_kokkos_volumetric_locking]
    type = Exodiff
    input = sczm_angled_kokkos.i
    cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/sczm/volumetric_locking_correction=true'
    exodiff = sczm_angled_kokkos_out.e
    abs_zero = 1e-8
    rel_err = 1e-8
    recover = false
    requirement = 'The Kokkos SCZM directional correction shall accept Cartesian two-dimensional volumetric locking correction and preserve the converged solution while applying its bulk-element trial-gradient average to the diagonal directional Jacobian blocks.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
  []
  [sczm_hetero_host_volumetric_locking]
    type = Exodiff
    input = sczm_hetero_host.i
    cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/sczm/volumetric_locking_correction=true Outputs/file_base=sczm_hetero_host_volumetric_locking_out'
    exodiff = sczm_hetero_host_volumetric_locking_out.e
    recover = false
    requirement = 'The host shifted cohesive-zone formulation shall compute a corrected heterogeneous angled-interface solution with independently configured primary and neighbor elastic responses.'
  []
  [sczm_hetero_kokkos_volumetric_locking_matches_host]
    type = Exodiff
    input = sczm_hetero_kokkos.i
    cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/sczm/volumetric_locking_correction=true Outputs/file_base=sczm_hetero_kokkos_volumetric_locking_out'
    exodiff = sczm_hetero_kokkos_volumetric_locking_out.e
    abs_zero = 1e-8
    rel_err = 1e-8
    recover = false
    requirement = 'The Kokkos SCZM volumetric-locking correction shall use the primary and neighbor side''s own volume-averaged trial gradients and row-side tangents, reproducing the host solution on a heterogeneous angled interface.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
  []
  [sczm_volumetric_locking_sensitivity]
    requirement = 'The Kokkos SCZM volumetric-locking correction shall change the stabilized diagonal Jacobian blocks, producing a different first linear-iteration residual from the correction-off matrix.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
    max_parallel = 1
    recover = false
    [off]
      type = RunApp
      input = sczm_angled_kokkos.i
      max_parallel = 1
      cli_args = 'Executioner/petsc_options=-ksp_monitor Outputs/exodus=false'
      expect_out = '1 KSP Residual norm 1.508085642598e-02'
      detail = 'with the correction disabled,'
    []
    [on]
      type = RunApp
      input = sczm_angled_kokkos.i
      max_parallel = 1
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/sczm/volumetric_locking_correction=true Executioner/petsc_options=-ksp_monitor Outputs/exodus=false'
      expect_out = '1 KSP Residual norm 1.619133203872e-02'
      detail = 'and with the correction enabled.'
    []
  []
  [sczm_angled_3d_kokkos_volumetric_locking]
    type = Exodiff
    input = sczm_angled_3d_kokkos.i
    cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/sczm/volumetric_locking_correction=true'
    exodiff = sczm_angled_3d_kokkos_out.e
    abs_zero = 1e-8
    rel_err = 1e-8
    recover = false
    requirement = 'The Kokkos SCZM directional correction shall accept Cartesian three-dimensional volumetric locking correction and preserve the converged solution while applying each side''s own bulk-element trial-gradient average to its diagonal directional Jacobian block.'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
  []


  # Unsupported combinations must be rejected explicitly. Each of these would otherwise be silently
  # dropped, leaving the user to believe an option took effect.
  [kokkos_directional_correction_rejections]
    requirement = 'The Kokkos SCZM directional correction shall reject unsupported input combinations with an explicit error.'
    design = 'syntax/Physics/SolidMechanics/ShiftedCohesiveZone/index.md'
    issues = '#33666 #30655'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = 'cpu cuda xpu'
    recover = false

    [non_cartesian_coordinates]
      type = RunException
      input = sczm_hetero_kokkos.i
      cli_args = 'Mesh/coord_type=RSPHERICAL'
      expect_err = 'currently supports only Cartesian coordinate systems'
      detail = 'if a non-Cartesian coordinate system is requested, whose out-of-plane kinematics are not yet verified for NEML2.'
    []

    [neml2_output_backend_not_kokkos]
      type = RunException
      input = sczm_hetero_kokkos.i
      cli_args = 'NEML2/primary_elasticity/output_backend=moose'
      expect_err = "Set 'output_backend = kokkos' or set 'directional_correction = false'"
      detail = 'if the NEML2 block providing the stress or tangent property to a Kokkos directional correction does not set output_backend = kokkos.'
    []

  []
[]
