    []
  []
  [salehani_finite_strain_shear]
    requirement = 'The system shall converge a total-Lagrangian shifted cohesive zone model with a '
                  'stiff Salehani-Irani traction-separation law under shear, solved with algebraic '
                  'multigrid, only with weighted traction stabilization, and shall then reproduce '
