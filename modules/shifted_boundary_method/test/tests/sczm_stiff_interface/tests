[Tests]
  design = 'syntax/Physics/SolidMechanics/ShiftedCohesiveZone/index.md'
  issues = '#33666'
  # Each group solves one problem with an interface about 1e5 times stiffer than the bulk, using
  # GMRES with algebraic multigrid: with an interface-fitted cohesive zone, with a shifted cohesive
  # zone without stabilization, which does not converge, and with a shifted cohesive zone with
  # weighted traction stabilization at the default stabilization_gamma, which converges to the
  # interface-fitted reactions. Reactions below 1e-6 in reaction.cmp are round-off of a reaction
  # that is zero for the loading at hand.
  [linear_shear]
    requirement = 'The system shall converge a shifted cohesive zone model with a stiff linear '
                  'traction-separation law under shear, solved with algebraic multigrid, only with '
                  'weighted traction stabilization, and shall then reproduce the interface-fitted '
                  'reaction history within one percent, by'
    [fitted]
      type = CheckFiles
      input = 'common.i fitted.i linear_shear.i'
      cli_args = 'Outputs/file_base=linear_shear_fitted'
      check_files = 'linear_shear_fitted.csv'
      recover = false
      detail = 'computing the reaction history of the interface-fitted cohesive zone model,'
    []
    [unstabilized]
      type = RunException
      input = 'common.i shifted.i linear_shear.i'
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/stabilization=none'
      expect_err = 'Solve failed and timestep already at or below dtmin'
      mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
      recover = false
      detail = 'failing to converge without stabilization,'
    []
    [weighted_traction]
      type = CheckFiles
      input = 'common.i shifted.i linear_shear.i'
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/stabilization=weighted_traction '
                 'Outputs/file_base=linear_shear_weighted'
      check_files = 'linear_shear_weighted.csv'
      mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
      recover = false
      detail = 'converging with weighted traction stabilization,'
    []
    [compare]
      type = RunCommand
      command = 'python3 ../../../../../python/mooseutils/csvdiff.py '
                'linear_shear_weighted.csv linear_shear_fitted.csv --comparison-file reaction.cmp'
      prereq = 'linear_shear/fitted linear_shear/weighted_traction'
      recover = false
      restep = false
      valgrind = none
      detail = 'and comparing the stabilized and interface-fitted reaction histories.'
    []
  []
  [bilinear_tension]
    requirement = 'The system shall converge a shifted cohesive zone model with a stiff mixed-mode '
                  'bilinear traction-separation law under tension into softening, solved with '
                  'algebraic multigrid, only with weighted traction stabilization, and shall then '
                  'reproduce the interface-fitted reaction history within one percent, by'
    [fitted]
      type = CheckFiles
      input = 'common.i fitted.i bilinear_tension.i'
      cli_args = 'Outputs/file_base=bilinear_tension_fitted'
      check_files = 'bilinear_tension_fitted.csv'
      recover = false
      detail = 'computing the reaction history of the interface-fitted cohesive zone model,'
    []
    [unstabilized]
      type = RunException
      input = 'common.i shifted.i bilinear_tension.i'
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/stabilization=none'
      expect_err = 'Solve failed and timestep already at or below dtmin'
      mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
      recover = false
      detail = 'failing to converge without stabilization,'
    []
    [weighted_traction]
      type = CheckFiles
      input = 'common.i shifted.i bilinear_tension.i'
      cli_args = 'Physics/SolidMechanics/ShiftedCohesiveZone/czm_ik/stabilization=weighted_traction '
                 'Outputs/file_base=bilinear_tension_weighted'
      check_files = 'bilinear_tension_weighted.csv'
      mesh_mode = REPLICATED # SBMSurfaceMeshBuilder requires a serial mesh
      recover = false
      detail = 'converging with weighted traction stabilization,'
    []
    [compare]
      type = RunCommand
      command = 'python3 ../../../../../python/mooseutils/csvdiff.py '
                'bilinear_tension_weighted.csv bilinear_tension_fitted.csv '
