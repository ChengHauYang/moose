[Tests]
  issues = '#33415'
  [cosserat_moment_balancing]
    type = PetscJacobianTester
    input = cosserat_moment_balancing.i
    requirement = 'The system shall preserve displacement and Cosserat-rotation derivatives through small Cosserat strain and linear elastic stress into force and moment residuals.'
    design = 'source/kernels/MomentBalancing.md source/materials/ComputeCosseratSmallStrain.md source/materials/ComputeCosseratLinearElasticStress.md'
  []
  [eigenstrain_from_initial_stress]
    type = PetscJacobianTester
    input = eigenstrain_from_initial_stress.i
    requirement = 'The system shall preserve elasticity-tensor derivatives through the symmetric inverse used to convert initial stress to eigenstrain and into each Cartesian displacement residual.'
    design = 'source/materials/ComputeEigenstrainFromInitialStress.md'
  []
  [plastic_heat_energy]
    type = PetscJacobianTester
    input = plastic_heat_energy.i
    requirement = 'The system shall preserve displacement derivatives through AD plastic strain and stress when assembling plastic heat in the thermal residual.'
    design = 'source/materials/ComputePlasticHeatEnergy.md source/kernels/PlasticHeatEnergy.md'
  []
  [interface_stress]
    type = PetscJacobianTester
    input = interface_stress.i
    requirement = 'The system shall preserve derivatives of interfacial stress with respect to each coupled order-parameter gradient in all three Cartesian displacement residuals.'
    design = 'source/materials/ComputeInterfaceStress.md'
  []
  [surface_tension]
    type = PetscJacobianTester
    input = surface_tension.i
    requirement = 'The system shall preserve derivatives of KKS surface tension through the order-parameter gradient and variable-dependent barrier and gradient-energy properties in the Cartesian displacement residuals.'
    design = 'source/materials/ComputeSurfaceTensionKKS.md'
  []
  [multiphase_stress]
    type = PetscJacobianTester
    input = multiphase_stress.i
    requirement = 'The system shall differentiate a mixture of AD phase stresses with respect to displacements and both nonlinear switching-function variables without requiring non-AD phase tangents.'
    design = 'source/materials/MultiPhaseStressMaterial.md'
  []
  [out_of_plane_pressure]
    requirement = 'The system shall apply the same prescribed out-of-plane pressure with AD and non-AD kernels, including function, scale-factor, and optional postprocessor inputs.'
    design = 'source/kernels/OutOfPlanePressure.md'
    [function]
      type = CSVDiff
      input = out_of_plane_pressure.i
      csvdiff = out_of_plane_pressure_out.csv
      detail = 'using a function and scale factor with the non-AD kernel'
    []
    [function_ad]
      type = CSVDiff
      input = out_of_plane_pressure.i
      csvdiff = out_of_plane_pressure_out.csv
      cli_args = 'Kernels/reaction/type=ADReaction Kernels/pressure/type=ADOutOfPlanePressure'
      detail = 'using a function and scale factor with the AD kernel'
    []
    [postprocessor]
      type = CSVDiff
      input = out_of_plane_pressure.i
      csvdiff = out_of_plane_pressure_out.csv
      cli_args = 'Kernels/pressure/factor=3 Kernels/pressure/postprocessor=load'
      detail = 'including a postprocessor multiplier with the non-AD kernel'
    []
    [postprocessor_ad]
      type = CSVDiff
      input = out_of_plane_pressure.i
      csvdiff = out_of_plane_pressure_out.csv
      cli_args = 'Kernels/reaction/type=ADReaction Kernels/pressure/type=ADOutOfPlanePressure
                  Kernels/pressure/factor=3 Kernels/pressure/postprocessor=load'
      detail = 'including a postprocessor multiplier with the AD kernel'
    []
  []
  [density_scaling]
    requirement = 'The system shall preserve density-scaling derivatives through the inertial residual and the additional-density property for both branches of the density maximum.'
    design = 'source/materials/DensityScaling.md'
    [scaled]
      type = PetscJacobianTester
      input = density_scaling.i
      detail = 'when the stable density exceeds the true density'
    []
    [unscaled]
      type = PetscJacobianTester
      input = density_scaling.i
      # Keep the stable density well below the true density, away from the max kink.
      cli_args = 'Materials/scaling/desired_time_step=0.001'
      detail = 'when the true density exceeds the stable density'
    []
  []
  [wave_speed]
    type = PetscJacobianTester
    input = wave_speed.i
    requirement = 'The system shall preserve wave-speed derivatives with respect to nonlinear density and effective-stiffness inputs when projecting the AD property to a field variable.'
    design = 'source/materials/WaveSpeed.md'
  []
  [inclusion_properties]
    type = CSVDiff
    input = inclusion_properties.i
    csvdiff = inclusion_properties_out.csv
    requirement = 'The system shall provide AD-compatible analytical inclusion stress, strain, and energy outputs that agree with the non-AD values inside and outside an elliptical inclusion.'
    design = 'source/materials/InclusionProperties.md'
  []
  [multiphase_stress_non_ad]
    type = PetscJacobianTester
    input = multiphase_stress.i
    cli_args = 'Kernels/x/type=StressDivergenceTensors
                Kernels/y/type=StressDivergenceTensors
                Kernels/z/type=StressDivergenceTensors
                Materials/strain/type=ComputeSmallStrain
                Materials/elasticity/type=ComputeIsotropicElasticityTensor
                Materials/stress/type=ComputeLinearElasticStress
                Materials/strain_b/type=ComputeSmallStrain
                Materials/elasticity_b/type=ComputeIsotropicElasticityTensor
                Materials/stress_b/type=ComputeLinearElasticStress
                Materials/weight_a/type=ParsedMaterial
                Materials/weight_a/expression=0.25
                Materials/weight_b/type=ParsedMaterial
                Materials/weight_b/expression=0.75
                Materials/mixed/type=MultiPhaseStressMaterial'
    requirement = 'The system shall retain the non-AD displacement Jacobian of a mixture of distinct elastic phases with constant switching functions.'
    design = 'source/materials/MultiPhaseStressMaterial.md'
  []
  [density_wave_values]
    requirement = 'The system shall compute the same scaled density, additional density, and wave speed from prescribed density and effective stiffness with AD and non-AD materials.'
    design = 'source/materials/DensityScaling.md source/materials/WaveSpeed.md'
    [non_ad]
      type = CSVDiff
      input = density_wave_values.i
      csvdiff = density_wave_values_out.csv
      detail = 'using the non-AD properties'
    []
    [ad]
      type = CSVDiff
      input = density_wave_values.i
      csvdiff = density_wave_values_out.csv
      cli_args = 'Materials/constants/type=ADGenericConstantMaterial
                  Materials/scaling/type=ADDensityScaling Materials/speed/type=ADWaveSpeed'
      detail = 'using the AD properties and AD-aware material output'
    []
  []

  [extra_stress]
    type = PetscJacobianTester
    input = extra_stress.i
    requirement = 'The system shall preserve independent nonlinear-variable derivatives through AD prefactor-scaled and van der Waals gas extra stresses when adding them to the elastic stress residual.'
    design = 'source/materials/ADComputeExtraStressConstant.md source/materials/ADComputeExtraStressVDWGas.md'
  []

  [composite_tensors]
    type = PetscJacobianTester
    input = composite_tensors.i
    requirement = 'The system shall preserve independent nonlinear-variable derivatives through weighted AD eigenstrain and elasticity tensor composites into the Cartesian displacement residuals.'
    design = 'source/materials/ADCompositeEigenstrain.md source/materials/ADCompositeElasticityTensor.md'
  []

  [compliance_sensitivity]
    type = PetscJacobianTester
    input = compliance_sensitivity.i
    requirement = 'The system shall preserve design-density and displacement derivatives through AD elasticity, stress, strain energy density, and compliance sensitivity into the projected sensitivity residual.'
    design = 'source/materials/ADComplianceSensitivity.md'
  []

  [global_strain]
    requirement = 'The system shall preserve displacement and global-strain derivatives through AD global strain, stress, and the global-strain scalar residual.'
    design = 'source/scalarkernels/ADGlobalStrain.md source/materials/ADComputeGlobalStrain.md source/userobjects/ADGlobalStrainUserObject.md'
    [two_dimensional]
      type = PetscJacobianTester
      input = global_strain.i
      detail = 'for the two-dimensional Action-created AD global-strain chain, including periodic scalar-row derivatives.'
    []
    [one_dimensional]
      type = PetscJacobianTester
      input = global_strain_1d.i
      detail = 'for distributed-mesh and threaded coverage of the AD global-strain chain.'
    []
  []

  [reduced_order_eigenstrain]
    requirement = 'The system shall preserve nonlinear eigenstrain derivatives through reduced-order projection into the Cartesian displacement residuals'
    design = 'source/materials/ADComputeReducedOrderEigenstrain.md'
    [volume_average]
      type = PetscJacobianTester
      input = reduced_order_eigenstrain.i
      detail = 'for volume averaging on first-order elements.'
    []
    [linear_projection]
      type = PetscJacobianTester
      input = reduced_order_eigenstrain.i
      cli_args = 'Mesh/second_order=true Variables/disp_x/order=SECOND Variables/disp_y/order=SECOND'
      detail = 'for linear least-squares projection on second-order elements.'
    []
  []

  [strain_energy_density]
    requirement = 'The system shall preserve displacement derivatives through AD stress and strain into the AD strain energy density'
    design = 'source/materials/StrainEnergyDensity.md'
    [total]
      type = PetscJacobianTester
      input = strain_energy_density.i
      detail = 'for a total strain formulation.'
    []
    [incremental]
      type = PetscJacobianTester
      input = strain_energy_density.i
      cli_args = 'Materials/strain/type=ADComputeIncrementalStrain
                  Materials/strain_energy_density/incremental=true'
      detail = 'for an incremental strain formulation.'
    []
  []
  [sum_tensor_increments]
    type = PetscJacobianTester
    input = sum_tensor_increments.i
    requirement = 'The system shall preserve both independent nonlinear-variable derivatives when summing two AD tensor increments into an AD tensor property.'
    design = 'source/materials/SumTensorIncrements.md'
  []
[]
