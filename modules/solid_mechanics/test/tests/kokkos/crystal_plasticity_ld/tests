[Tests]
  issues = '#30655'
  design = 'TorchDeformationGradient.md KokkosComputeLagrangianStressCustomPK2.md KokkosTotalLagrangianStressDivergence.md NEML2ToKokkosMaterialProperty.md KokkosDirichletBC.md NEML2Action.md'

  [host]
    type = Exodiff
    input = 'crystal_plasticity_ld_host.i'
    exodiff = 'crystal_plasticity_ld_host_out.e'
    capabilities = 'libtorch & neml2'
    compute_devices = cpu
    requirement = 'The system shall solve a three-dimensional total-Lagrangian finite-strain crystal-plasticity problem with total-mode F-bar stabilization on the host using a NEML2 constitutive model evaluated on the CPU.'
  []

  [host_neml2_cuda]
    type = Exodiff
    input = 'crystal_plasticity_ld_host.i'
    cli_args = 'NEML2/all/device=cuda Outputs/file_base=crystal_plasticity_ld_host_neml2_cuda_out'
    # The gold is a symlink to crystal_plasticity_ld_host_out.e.
    exodiff = 'crystal_plasticity_ld_host_neml2_cuda_out.e'
    custom_cmp = 'crystal_plasticity_ld.cmp'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cuda
    requirement = 'The system shall reproduce the three-dimensional host total-Lagrangian F-bar crystal-plasticity solution when the NEML2 constitutive update is evaluated on the CUDA device and assembled on the host.'
  []

  [kokkos]
    type = Exodiff
    input = 'crystal_plasticity_ld_kokkos.i'
    # The gold is a symlink to crystal_plasticity_ld_host_out.e.
    exodiff = 'crystal_plasticity_ld_kokkos_out.e'
    custom_cmp = 'crystal_plasticity_ld.cmp'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cpu
    requirement = 'The system shall reproduce the three-dimensional host total-Lagrangian F-bar crystal-plasticity solution using TorchDeformationGradient, KokkosComputeFbarAverage, full rank-two and rank-four Kokkos material bridges, KokkosComputeLagrangianStressCustomPK2, and KokkosTotalLagrangianStressDivergence with CPU NEML2 evaluation.'
  []

  [kokkos_neml2_cuda]
    type = Exodiff
    input = 'crystal_plasticity_ld_kokkos.i'
    cli_args = 'NEML2/all/device=cuda -vec_type standard -nl0_mat_type aij Outputs/file_base=crystal_plasticity_ld_kokkos_neml2_cuda_out'
    # The gold is a symlink to crystal_plasticity_ld_host_out.e.
    exodiff = 'crystal_plasticity_ld_kokkos_neml2_cuda_out.e'
    custom_cmp = 'crystal_plasticity_ld.cmp'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cuda
    requirement = 'The system shall reproduce the three-dimensional host total-Lagrangian F-bar crystal-plasticity solution when both the NEML2 constitutive update and the Kokkos total-Lagrangian assembly run on the CUDA device with host PETSc linear algebra.'
  []

  [kokkos_full_gpu]
    type = Exodiff
    input = 'crystal_plasticity_ld_kokkos.i'
    cli_args = 'NEML2/all/device=cuda -vec_type kokkos -nl0_mat_type aijkokkos -hypre_umpire_device_pool_size 256 Outputs/file_base=crystal_plasticity_ld_kokkos_full_gpu_out'
    # The gold is a symlink to crystal_plasticity_ld_host_out.e.
    exodiff = 'crystal_plasticity_ld_kokkos_full_gpu_out.e'
    custom_cmp = 'crystal_plasticity_ld.cmp'
    capabilities = 'kokkos & libtorch & neml2'
    compute_devices = cuda
    requirement = 'The system shall reproduce the three-dimensional host total-Lagrangian F-bar crystal-plasticity solution when the NEML2 constitutive update, Kokkos total-Lagrangian assembly, and PETSc AIJKOKKOS solve all run on the CUDA device.'
  []
[]
