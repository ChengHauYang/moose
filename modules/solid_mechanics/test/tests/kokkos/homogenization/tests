[Tests]
  issues = '#31355'
  design = 'KokkosHomogenizedTotalLagrangianStressDivergence.md'

  [csv]
    requirement = 'The Kokkos total-Lagrangian homogenization system shall reproduce the host solution, on CPUs and GPUs, for'
    [small_1d_strain]
      type = CSVDiff
      input = 'small_1d.i'
      csvdiff = '1d-strain_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/small-tests/gold'
      cli_args = "Outputs/file_base=1d-strain_out constraint_types='strain none none none none none none "
                 "none none' targets=func_strain"
      detail = 'a strain constraint in 1D with small kinematics.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [small_1d_stress]
      type = CSVDiff
      input = 'small_1d.i'
      csvdiff = '1d-stress_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/small-tests/gold'
      cli_args = "Outputs/file_base=1d-stress_out constraint_types='stress none none none none none none "
                 "none none' targets=func_stress"
      detail = 'a stress constraint in 1D with small kinematics.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [small_2d_strain]
      type = CSVDiff
      input = 'small_2d.i'
      csvdiff = '2d-strain_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/small-tests/gold'
      cli_args = "Outputs/file_base=2d-strain_out constraint_types='strain none none strain strain none "
                 "none none none' targets='strain11 strain12 strain22'"
      detail = 'strain constraints in 2D with small kinematics.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [small_2d_stress]
      type = CSVDiff
      input = 'small_2d.i'
      csvdiff = '2d-stress_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/small-tests/gold'
      cli_args = "Outputs/file_base=2d-stress_out constraint_types='stress none none stress stress none "
                 "none none none' targets='stress11 stress12 stress22'"
      detail = 'stress constraints in 2D with small kinematics.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [small_2d_mixed]
      type = CSVDiff
      input = 'small_2d.i'
      csvdiff = '2d-mixed_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/small-tests/gold'
