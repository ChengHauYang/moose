                 "strain strain none stress stress stress' targets='stress11 strain12 strain22 stress13 "
                 "stress23 stress33'"
      detail = 'mixed stress and strain constraints in 3D with small kinematics and the volumetric locking correction.'
      capabilities = 'kokkos & method!=dbg'
      compute_devices = 'cpu cuda'
    []
    [large_1d_stress]
      type = CSVDiff
      input = 'large_1d.i'
      csvdiff = '1d-stress-svk_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/large-tests/gold'
      cli_args = "Outputs/file_base=1d-stress-svk_out constraint_types='stress none none none none none "
                 "none none none' targets=func_stress"
      detail = 'a stress constraint in 1D with large kinematics.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [large_2d_strain]
      type = CSVDiff
      input = 'large_2d.i'
      csvdiff = '2d-strain-svk_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/large-tests/gold'
      cli_args = "Outputs/file_base=2d-strain-svk_out constraint_types='strain strain none strain strain "
                 "none none none none' targets='strain11 strain21 strain12 strain22'"
      detail = 'strain constraints in 2D with large kinematics.'
      capabilities = 'kokkos & method!=dbg'
      compute_devices = 'cpu cuda'
    []
    [large_2d_stress]
      type = CSVDiff
      input = 'large_2d.i'
      csvdiff = '2d-stress-svk_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/large-tests/gold'
      cli_args = "Outputs/file_base=2d-stress-svk_out constraint_types='stress stress none strain stress "
                 "none none none none' targets='stress11 stress21 0 stress22'"
      detail = 'stress constraints in 2D with large kinematics.'
      capabilities = 'kokkos & method!=dbg'
