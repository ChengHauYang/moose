                 "none none none' targets='stress11 stress12 strain22'"
      detail = 'mixed stress and strain constraints in 2D with small kinematics.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [small_2d_mixed_bbar]
      type = CSVDiff
      input = 'small_2d.i'
      csvdiff = '2d-mixed-bbar_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/small-tests/gold'
      cli_args = "Outputs/file_base=2d-mixed-bbar_out STABILIZE=true constraint_types='stress none none "
                 "stress strain none none none none' targets='stress11 stress12 strain22'"
      detail = 'mixed stress and strain constraints in 2D with small kinematics and the volumetric locking correction.'
      capabilities = 'kokkos'
      compute_devices = 'cpu cuda'
    []
    [small_3d_strain]
      type = CSVDiff
      input = 'small_3d.i'
      csvdiff = '3d-strain_out.csv'
      gold_dir = '../../lagrangian/cartesian/total/homogenization/small-tests/gold'
      cli_args = "Outputs/file_base=3d-strain_out constraint_types='strain none none strain strain none "
                 "strain strain strain' targets='strain11 strain12 strain22 strain13 strain23 strain33'"
      detail = 'strain constraints in 3D with small kinematics.'
      capabilities = 'kokkos & method!=dbg'
      compute_devices = 'cpu cuda'
    []
    [small_3d_stress]
      type = CSVDiff
      input = 'small_3d.i'
