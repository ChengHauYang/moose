[Tests]
  issues = '#33198'
  design = 'source/materials/cohesive_zone_model/BiLinearMixedModeTraction.md source/neml2/actions/NEML2Action.md'
  [bilinear_mixed_moose]
    type = Exodiff
    input = 'bilinear_mixed_moose.i'
    exodiff = 'bilinear_mixed_moose_out.e'
    requirement = 'The system shall compute the reaction-force history of a bi-linear mixed-mode cohesive zone problem using the native MOOSE cohesive traction law.'
  []
  [bilinear_mixed_neml2]
    type = Exodiff
    input = 'bilinear_mixed_neml2.i'
    # The gold is a symlink to the native-MOOSE reference output above. The custom
    # comparison accounts for the known bracket-formulation difference.
    exodiff = 'bilinear_mixed_neml2_out.e'
    custom_cmp = 'react_xy.cmp'
    capabilities = 'libtorch & neml2'
    requirement = 'The system shall reproduce the reaction-force history of an equivalent cohesive zone problem within the react_xy.cmp tolerances using the NEML2 traction separation law.'
  []
