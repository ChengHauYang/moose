[Tests]
  design = 'syntax/Kokkos/index.md'
  issues = '#31370'
  capabilities = kokkos
  compute_devices = 'cpu cuda xpu'

  [constant_on_rejected]
    type = RunException
    # A working interface input; the CLI argument sets an unsupported constant mode.
    input = ../interface_material.i
    cli_args = 'Materials/interface_material/constant_on=ELEMENT'
    expect_err = 'Kokkos interface materials currently only support constant_on = NONE.'
    requirement = 'The Kokkos interface material system shall reject constant_on = ELEMENT.'
  []
]
