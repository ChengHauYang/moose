[Tests]
  issues = '#30655'
  [penalty_jacobian]
    type = PetscJacobianTester
    input = penalty.i
    ratio_tol = 1e-7
    difference_tol = 1e-7
    requirement = 'The Kokkos system shall assemble residual contributions on both sides of an interface and all four interface Jacobian blocks.'
    design = 'syntax/Kokkos/index.md'
    capabilities = kokkos
    compute_devices = 'cpu cuda xpu'
  []
  [interface_material_jacobian]
    type = PetscJacobianTester
    input = interface_material.i
    ratio_tol = 1e-7
    difference_tol = 1e-7
    requirement = 'The Kokkos system shall evaluate an interface material once per oriented interface face on the primary element owner, and assemble a device-resident material property from both residual rows and all four Jacobian blocks of that face.'
    design = 'syntax/Kokkos/index.md'
    capabilities = kokkos
    compute_devices = 'cpu cuda xpu'
  []

  [interface_user_object]
    type = CSVDiff
    input = interface_user_object.i
    csvdiff = interface_user_object_out.csv
    requirement = 'The Kokkos system shall dispatch a user object once per oriented interface face and provide primary and mapped neighbor quadrature-point data to its device hook.'
    design = 'syntax/Kokkos/index.md'
    capabilities = kokkos
    compute_devices = 'cpu cuda xpu'
  []

  [two_sided_address_values]
    type = Exodiff
    input = two_sided_address.i
    exodiff = two_sided_address_out.e
    requirement = 'The Kokkos system shall publish one interface face property into boundary property storage from the primary side and into neighbor property storage from the neighbor side, and a Kokkos interface kernel shall read each side back at the quadrature point of that side.'
    detail = 'comparing the assembled solution against a gold file, so that reading the wrong face, the wrong quadrature point, or the wrong pair of storages changes the solution.'
    design = 'syntax/Kokkos/index.md'
    capabilities = kokkos
    compute_devices = 'cpu cuda xpu'
  []

  [two_sided_address_jacobian]
    type = PetscJacobianTester
    input = two_sided_address.i
    ratio_tol = 1e-7
    difference_tol = 1e-7
    requirement = 'The Kokkos system shall publish one interface face property into boundary property storage from the primary side and into neighbor property storage from the neighbor side, and a Kokkos interface kernel shall read each side back at the quadrature point of that side.'
    detail = 'verifying that the assembled Jacobian is the derivative of that same two-sided residual.'
    design = 'syntax/Kokkos/index.md'
    capabilities = kokkos
    compute_devices = 'cpu cuda xpu'
  []

  [stateful]
    requirement = 'The Kokkos system shall preserve the state of a stateful interface material property over a checkpoint write and a restart by'
    design = 'syntax/KokkosMaterials/index.md'
    [write_checkpoint]
      type = RunApp
      input = stateful.i
      detail = 'writing the current and old state of an interface material property into a checkpoint file.'
      capabilities = kokkos
      compute_devices = 'cpu cuda xpu'
    []
    [restart]
      type = Exodiff
      input = stateful_restart.i
      exodiff = stateful_restart_out.e
      detail = 'loading that state on restart and continuing the transient, which reproduces the solution of the uninterrupted run because the interface traction of each accepted step accumulates.'
      capabilities = kokkos
      compute_devices = 'cpu cuda xpu'
      prereq = 'stateful/write_checkpoint'
    []
  []
[]
